{
  "name": "crm",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter api exec drizzle-kit generate",
    "db:migrate": "pnpm --filter api exec drizzle-kit migrate",
    "db:push": "pnpm --filter api exec drizzle-kit push",
    "db:studio": "pnpm --filter api exec drizzle-kit studio"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@better-fetch/fetch": "1.3.1",
        "better-call": "1.3.7",
        "drizzle-orm": "1.0.0-rc.4",
        "kysely": "0.29.5"
      }
    }
  }
}
