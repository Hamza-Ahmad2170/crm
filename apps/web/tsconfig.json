{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@api/*": ["../api/src/*"],
      "@server/*": ["../api/src/*"],
      "@/auth/*": ["../api/src/auth/*"],
      "@/config/*": ["../api/src/config/*"],
      "@/db/*": ["../api/src/db/*"],
      "@/jobs/*": ["../api/src/jobs/*"],
      "@/modules/*": ["../api/src/modules/*"],
      "@/lib/http/*": ["../api/src/lib/http/*"],
      "@/lib/pagination.js": ["../api/src/lib/pagination.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
